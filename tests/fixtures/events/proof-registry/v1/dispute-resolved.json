{
  "event": "dispute_resolved",
  "contract": "proof-registry",
  "contract_version": "0.1.0",
  "schema_version": 1,
  "topics": ["dispute_resolved"],
  "payload": {
    "proof_id_hash": {
      "type": "BytesN<32>",
      "description": "Identifier hash of the proof whose dispute was resolved."
    },
    "resolved_by": {
      "type": "Address",
      "description": "Administrator that resolved the dispute."
    },
    "resolved_by_class": {
      "type": "DisputeActorClass",
      "description": "Coarse role classification of the resolver."
    },
    "resolved_at": {
      "type": "U64",
      "description": "Ledger timestamp of the resolution."
    }
  },
  "emitted_by": "resolve_dispute",
  "description": "Legacy resolution event retained unchanged for existing indexers.",
  "compatibility": "stable"
}