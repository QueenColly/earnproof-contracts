{
  "event": "HashAlgorithmApproved",
  "contract": "protocol-config",
  "contract_version": "0.1.0",
  "schema_version": 1,
  "topics": [
    "HashAlgorithmApproved"
  ],
  "payload": {
    "algorithm_id": {
      "type": "U32",
      "description": "Commitment hash algorithm identifier.",
      "example": 7
    },
    "revision": {
      "type": "U32",
      "description": "Number of lifecycle changes applied to this identifier, starting at 1.",
      "example": 1
    },
    "approved_at": {
      "type": "U64",
      "description": "Ledger timestamp of the change.",
      "example": 1500
    }
  },
  "emitted_by": "approve_hash_algorithm",
  "description": "Emitted when governance approves a commitment hash algorithm identifier.",
  "compatibility": "additive"
}
